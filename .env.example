# Clipe Consult — Environment Variables
#
# Copy this file to `.env.local` (for local dev) or `.env` (for production)
# and fill in the values.
#
# IMPORTANT: Never commit the real .env file. It is gitignored.

# ─────────────────────────────────────────────────────────────────────────────
# 1. SITE URL (required)
# ─────────────────────────────────────────────────────────────────────────────
# The canonical public URL of your deployed site. Used for SEO metadata,
# Open Graph tags, and Schema.org structured data.
NEXT_PUBLIC_SITE_URL="https://clipeconsult.com"

# ─────────────────────────────────────────────────────────────────────────────
# 2. SERVER PORT (required for VPS deployment)
# ─────────────────────────────────────────────────────────────────────────────
# The TCP port the Next.js standalone server will listen on.
#
# On a Webuzo VPS shared by multiple sites, port 3000 may already be in use
# by another app. Run `bash scripts/check-port.sh` on the VPS to find a free
# port, then set it here. Common safe choices: 3000, 3001, 3002, 8080, 8081.
#
# If you leave this commented out, deploy.sh will auto-detect a free port
# during deployment (but it won't be remembered between restarts).
PORT=3000

# ─────────────────────────────────────────────────────────────────────────────
# 3. Database (optional — only needed if you wire up Prisma for forms/leads)
# ─────────────────────────────────────────────────────────────────────────────
# SQLite (default — file-based, no setup needed):
DATABASE_URL="file:./dev.db"
# Or use MySQL on the Webuzo VPS (recommended for production):
# DATABASE_URL="mysql://clipe_user:YOUR_PASSWORD@localhost:3306/clipe_consult"

# ─────────────────────────────────────────────────────────────────────────────
# 4. Contact form delivery (optional — only if you wire up email sending)
# ─────────────────────────────────────────────────────────────────────────────
# Where enquiries submitted via the contact form should be sent.
CONTACT_FORM_TO_EMAIL="info@clipeconsult.com"
CONTACT_FORM_CC_EMAIL="clipeconsult@gmail.com"

# SMTP credentials (use the Webuzo mail server OR a service like Gmail/Resend):
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="clipeconsult@gmail.com"
# SMTP_PASSWORD="YOUR_GMAIL_APP_PASSWORD"
# SMTP_FROM="Clipe Consult <clipeconsult@gmail.com>"

# ─────────────────────────────────────────────────────────────────────────────
# 5. NextAuth.js (optional — only if you add authentication)
# ─────────────────────────────────────────────────────────────────────────────
# Generate a random 32+ char string: `openssl rand -base64 32`
# NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
# NEXTAUTH_URL="https://clipeconsult.com"
